# Origin of redbiiddsun-service (the API). Used for the dev proxy of /api and for the
# OAuth callback URL shown in the admin. Copy this file to .env and adjust.
# Local development can leave it unset: it falls back to http://localhost:3000.
# Production builds must set it (e.g. in the Vercel project env) and it must match
# the /api rewrite destination in vercel.json.
VITE_API_URL=http://localhost:3000
